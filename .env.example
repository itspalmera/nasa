# Copy to .env in the repository root. Never commit your real API key.
# OpenAI API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Reserved only: no Consensus API adapter is configured. CSV/JSON imports need no key.
CONSENSUS_API_KEY=
# API spending is opt-in, even when a key exists.
ENABLE_PAID_API=false
MAX_INGEST_DOCUMENTS=50
MAX_FILE_MB=40
MAX_INGEST_TOKENS=500000
EMBEDDING_USD_PER_MILLION=0.02
INPUT_USD_PER_MILLION=0.15
OUTPUT_USD_PER_MILLION=0.60
# Local API only. Set a token for all /api routes if using a shared machine.
FLAME_API_TOKEN=

# Client timeout/retries and maximum retrieved evidence budget per answer.
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
RAG_MAX_CONTEXT_TOKENS=16000

# Answer synthesis provider: openai (default) or anthropic. Embeddings stay OpenAI-only.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=12000

# Optional: read the PSI catalog from Supabase (tables from supabase_seed.sql). Empty = local JSON.
# Use the anon/publishable key from Project Settings > API, never the service_role key.
SUPABASE_URL=
SUPABASE_KEY=
